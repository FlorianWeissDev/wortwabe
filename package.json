{
  "name": "wortwabe",
  "version": "0.1.0",
  "description": "A German weekly word puzzle on a honeycomb of seven letters",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
